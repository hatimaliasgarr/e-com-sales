{
  "cells": [
    {"cell_type": "markdown", "metadata": {}, "source": ["# Exploratory Data Analysis - E-Commerce Sales Analytics\n", "\n", "This notebook performs exploratory data analysis on the Brazilian e-commerce dataset (Olist) including:\n", "- Data overview and summary statistics\n", "- Distribution analysis of key variables\n", "- Revenue and order trends\n", "- Geographic distribution\n", "- Customer behavior patterns"]},
    {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["import pandas as pd\n", "import numpy as np\n", "import matplotlib.pyplot as plt\n", "import seaborn as sns\n", "\n", "# Configure plotting\n", "plt.style.use('dark_background')\n", "sns.set_palette('husl')\n", "pd.set_option('display.max_columns', None)\n", "pd.set_option('display.float_format', lambda x: f'{x:,.2f}')"]},
    {"cell_type": "markdown", "metadata": {}, "source": ["## 1. Load Datasets"]},
    {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["# Load all datasets\n", "customers = pd.read_csv('../data/processed/customers.csv')\n", "orders = pd.read_csv('../data/processed/orders.csv')\n", "items = pd.read_csv('../data/processed/order_items.csv')\n", "products = pd.read_csv('../data/processed/products.csv')\n", "payments = pd.read_csv('../data/processed/payments.csv')\n", "reviews = pd.read_csv('../data/processed/reviews.csv')\n", "sellers = pd.read_csv('../data/processed/sellers.csv')\n", "\n", "print(f'Customers: {len(customers):,} rows')\n", "print(f'Orders: {len(orders):,} rows')\n", "print(f'Order Items: {len(items):,} rows')\n", "print(f'Products: {len(products):,} rows')\n", "print(f'Payments: {len(payments):,} rows')\n", "print(f'Reviews: {len(reviews):,} rows')\n", "print(f'Sellers: {len(sellers):,} rows')"]},
    {"cell_type": "markdown", "metadata": {}, "source": ["## 2. Data Overview"]},
    {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["# Orders overview\n", "print('=== Orders Info ===')\n", "print(orders.info())\n", "print('\\n=== Orders Summary ===')\n", "orders.describe()"]},
    {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["# Check for missing values\n", "print('=== Missing Values ===')\n", "for name, df in [('customers', customers), ('orders', orders), ('items', items)]:\n", "    missing = df.isnull().sum()\n", "    if missing.any():\n", "        print(f'\\n{name}:')\n", "        print(missing[missing > 0])"]},
    {"cell_type": "markdown", "metadata": {}, "source": ["## 3. Revenue Analysis"]},
    {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["# Monthly revenue trend\n", "orders['order_purchase_timestamp'] = pd.to_datetime(orders['order_purchase_timestamp'])\n", "merged = items.merge(orders[['order_id','order_purchase_timestamp','order_status']], on='order_id')\n", "merged['month'] = merged['order_purchase_timestamp'].dt.to_period('M')\n", "\n", "monthly = merged.groupby('month').agg(\n", "    revenue=('price', 'sum'),\n", "    orders=('order_id', 'nunique'),\n", "    aov=('price', 'mean')\n", ").reset_index()\n", "\n", "fig, ax = plt.subplots(figsize=(14, 5))\n", "ax.fill_between(range(len(monthly)), monthly['revenue'], alpha=0.3, color='#3b82f6')\n", "ax.plot(range(len(monthly)), monthly['revenue'], color='#3b82f6', linewidth=2)\n", "ax.set_title('Monthly Revenue Trend', fontsize=16, fontweight='bold')\n", "ax.set_ylabel('Revenue ($)')\n", "plt.xticks(range(len(monthly)), monthly['month'].astype(str), rotation=45)\n", "plt.tight_layout()\n", "plt.show()"]},
    {"cell_type": "markdown", "metadata": {}, "source": ["## 4. Geographic Distribution"]},
    {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["# Revenue by state\n", "state_revenue = merged.merge(customers[['customer_id','customer_state']], \n", "                              left_on='order_id', right_on='customer_id', how='left')\n", "state_summary = state_revenue.groupby('customer_state')['price'].sum().sort_values(ascending=False).head(10)\n", "\n", "fig, ax = plt.subplots(figsize=(10, 6))\n", "state_summary.plot(kind='barh', ax=ax, color='#3b82f6', alpha=0.8)\n", "ax.set_title('Top 10 States by Revenue', fontsize=16, fontweight='bold')\n", "ax.set_xlabel('Revenue ($)')\n", "plt.tight_layout()\n", "plt.show()"]},
    {"cell_type": "markdown", "metadata": {}, "source": ["## 5. Category Analysis"]},
    {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["# Top categories\n", "cat_items = items.merge(products[['product_id','product_category_name_english']], on='product_id')\n", "cat_summary = cat_items.groupby('product_category_name_english')['price'].sum().sort_values(ascending=False).head(10)\n", "\n", "fig, ax = plt.subplots(figsize=(10, 6))\n", "cat_summary.plot(kind='barh', ax=ax, color='#10b981', alpha=0.8)\n", "ax.set_title('Top 10 Product Categories by Revenue', fontsize=16, fontweight='bold')\n", "ax.set_xlabel('Revenue ($)')\n", "plt.tight_layout()\n", "plt.show()"]},
    {"cell_type": "markdown", "metadata": {}, "source": ["## 6. Review Analysis"]},
    {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["# Review score distribution\n", "fig, ax = plt.subplots(figsize=(8, 5))\n", "reviews['review_score'].value_counts().sort_index().plot(kind='bar', ax=ax,\n", "    color=['#ef4444','#f97316','#f59e0b','#34d399','#10b981'], alpha=0.8)\n", "ax.set_title('Review Score Distribution', fontsize=16, fontweight='bold')\n", "ax.set_xlabel('Score')\n", "ax.set_ylabel('Count')\n", "plt.tight_layout()\n", "plt.show()\n", "\n", "print(f'Average Review Score: {reviews[\"review_score\"].mean():.2f}')"]},
    {"cell_type": "markdown", "metadata": {}, "source": ["## Summary\n", "- Total Revenue: ${:,.2f}\\n\".format(items['price'].sum()),\n", "- Total Orders: {:,}\\n\".format(orders['order_id'].nunique()),\n", "- Avg Order Value: ${:,.2f}\\n\".format(items['price'].mean()),\n", "- Unique Customers: {:,}\\n\".format(customers['customer_id'].nunique()),\n", "- Avg Review Score: {:.2f}/5\".format(reviews['review_score'].mean())]}
  ],
