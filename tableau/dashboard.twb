  <worksheets>
    <worksheet name='Monthly Revenue Trend'>
      <table>
        <view>
          <datasources>
            <datasource caption=' (2)' name='ecommerce_data' />
          </datasources>
          <datasource-dependencies datasource='ecommerce_data'>
            <column caption='Order Date' datatype='datetime' name='[order_purchase_timestamp]' role='dimension' type='ordinal' />
            <column caption='Price' datatype='real' name='[price]' role='measure' type='quantitative' />
            <column-instance column='[price]' derivation='Sum' name='[sum:price:qk]' pivot='key' type='quantitative' />
            <column-instance column='[order_purchase_timestamp]' derivation='Month-Trunc' name='[tmn:order_purchase_timestamp:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-disallow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
          </pane>
        </panes>
        <rows>[ecommerce_data].[sum:price:qk]</rows>
        <cols>[ecommerce_data].[tmn:order_purchase_timestamp:qk]</cols>
      </table>
      <simple-id uuid='{096EE46A-7A2A-4DAC-9592-0E7875BE36A5}' />
    </worksheet>
    <worksheet name='Revenue by State'>
      <table>
        <view>
          <datasources>
